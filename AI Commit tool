# Project Note: `git-ai` (CLI Commit Generator)

An agentic terminal utility built with Python and Google's `gemini-3.8-flash` model. It inspects staged code differences via `git diff --cached`, synthesizes changes into three concise Conventional Commit messages, and lets you commit directly with a single keystroke.

---

### 1. System Architecture

```text
[Your Code Changes] 
       │
       ▼
  git add <files> 
       │
       ▼
 [ git ai ] ────────► subprocess: git diff --cached
       │
       ▼
 [ Gemini API ] ────► Prompt: Analyze diff -> 3 Conventional Commits
  (gemini-3.8-flash)  Config: thinking_level="LOW" + retry on 503
       │
       ▼
[ Terminal Menu ] ──► [1], [2], [3] (Select) or [c] (Cancel)
       │
       ▼
subprocess.run ────► git commit -m "<selected message>"

```

---

### 2. Complete Source Code (`~/.local/bin/git-ai`)

```python
#!/usr/bin/env python3
"""
git-ai: Interactive AI-powered conventional git commit generator.
Powered by Google Gemini 3.8 Flash.
"""
import os
import subprocess
import sys
import time
from google import genai
from google.genai import types

MODELS_TO_TRY = ["gemini-3.8-flash", "gemini-3.8-pro", "gemini-2.0-flash"]

def get_staged_diff() -> str:
    """Capture the diff of staged files."""
    result = subprocess.run(
        ["git", "diff", "--cached"],
        capture_output=True,
        text=True
    )
    return result.stdout.strip()

def generate_commit_messages(diff: str, client: genai.Client) -> list[str]:
    """Request 3 conventional commit options from Gemini with retry & fallback."""
    prompt = f"""
You are an expert developer. Analyze the following staged git diff and generate exactly 3 distinct, concise Conventional Commit messages.
Follow the conventional commits standard (e.g., feat:, fix:, refactor:, chore:, docs:).
Each message must be on a single line, under 72 characters, and written in the imperative mood (e.g., "add", "fix", not "added" or "fixes").

Return ONLY the 3 commit messages, one per line. Do not include markdown formatting, numbers, bullets, or extra text.

Git Diff:
{diff}
"""
    config = types.GenerateContentConfig(
        thinking_config=types.ThinkingConfig(thinking_level="LOW")
    )

    last_error = None

    for model_name in MODELS_TO_TRY:
        for attempt in range(1, 3):
            try:
                response = client.models.generate_content(
                    model=model_name,
                    contents=prompt,
                    config=config
                )
                raw_lines = response.text.strip().split("\n")
                messages = [
                    line.strip().lstrip("123456789.-* ")
                    for line in raw_lines
                    if line.strip()
                ]
                if messages:
                    return messages[:3]
            except Exception as e:
                err_str = str(e)
                last_error = e
                if "503" in err_str or "UNAVAILABLE" in err_str:
                    time.sleep(2)
                elif "404" in err_str or "NOT_FOUND" in err_str:
                    break
                else:
                    break

    raise last_error

def main():
    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        print("Error: GEMINI_API_KEY environment variable is not set.", file=sys.stderr)
        sys.exit(1)

    diff = get_staged_diff()
    if not diff:
        print("No staged changes found. Run 'git add <files>' first.")
        sys.exit(0)

    # Protect prompt budget against oversized payloads
    if len(diff) > 25000:
        diff = diff[:25000] + "\n\n[Diff truncated due to size...]"

    client = genai.Client(api_key=api_key)
    print("Analyzing staged changes with Gemini...\n")

    try:
        suggestions = generate_commit_messages(diff, client)
    except Exception as e:
        print(f"\nAPI Error: {e}", file=sys.stderr)
        sys.exit(1)

    if not suggestions:
        print("No commit suggestions generated.")
        sys.exit(1)

    print("Suggested commit messages:")
    for idx, msg in enumerate(suggestions, 1):
        print(f"  [{idx}] {msg}")
    print("  [c] Cancel")

    choice = input("\nSelect an option [1-3, c]: ").strip().lower()

    if choice in ("1", "2", "3"):
        selected = suggestions[int(choice) - 1]
        subprocess.run(["git", "commit", "-m", selected])
        print(f"\nCommitted: \"{selected}\"")
    else:
        print("Aborted. No commit made.")

if __name__ == "__main__":
    main()

```

